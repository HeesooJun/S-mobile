<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="signature_prefs.xml"/>
        <exclude domain="database" path="app-database.db"/>
        <exclude domain="database" path="app-database.db-wal"/>
        <exclude domain="database" path="app-database.db-shm"/>
        <exclude domain="database" path="app-database.db-journal"/>
        <exclude domain="file" path="datastore/survivor_profile.preferences_pb"/>
        <exclude domain="file" path="datastore/survivor_profile.preferences_pb.tmp"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="signature_prefs.xml"/>
        <exclude domain="database" path="app-database.db"/>
        <exclude domain="database" path="app-database.db-wal"/>
        <exclude domain="database" path="app-database.db-shm"/>
        <exclude domain="database" path="app-database.db-journal"/>
        <exclude domain="file" path="datastore/survivor_profile.preferences_pb"/>
        <exclude domain="file" path="datastore/survivor_profile.preferences_pb.tmp"/>
    </device-transfer>
</data-extraction-rules>
